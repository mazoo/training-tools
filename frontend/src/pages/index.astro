  function renderPreview(step: any): string {
    return `
      <div class="space-y-3">
        <div class="flex flex-col gap-1 text-xs text-gray-300 sm:flex-row sm:items-center sm:justify-between">
          <span>${step.filters}</span>
          <span>${step.candidates.length} candidate${step.candidates.length === 1 ? "" : "s"}</span>
        </div>
        <div class="space-y-3">
          ${step.candidates.map(card).join("")}
        </div>
      </div>
    `;
  }

  const modal = document.getElementById("preview-tour-modal");
  const closeButton = document.getElementById("preview-tour-close");
  const prevButton = document.getElementById("tour-prev") as HTMLButtonElement | null;
  const nextButton = document.getElementById("tour-next") as HTMLButtonElement | null;
  const titleEl = document.getElementById("preview-tour-title");
  const labelEl = document.getElementById("tour-step-label");
  const bodyEl = document.getElementById("tour-body");
  const highlightsEl = document.getElementById("tour-highlights");
  const previewEl = document.getElementById("tour-preview");
  const dotsEl = document.getElementById("tour-dots");
  let currentTourStep = 0;
  let lastFocusedElement: Element | null = null;

  function renderTourStep() {
    const step = tourSteps[currentTourStep];
    if (!step) return;

    if (titleEl) titleEl.textContent = step.title;
    if (labelEl) labelEl.textContent = `Example ${currentTourStep + 1} of ${tourSteps.length}`;
    if (bodyEl) bodyEl.textContent = step.body;
    if (highlightsEl) {
      highlightsEl.innerHTML = step.highlights.map((highlight) => `
        <div class="flex gap-3 text-sm text-gray-100">
          <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-sky-400"></span>
          <span>${highlight}</span>
        </div>
      `).join("");
    }
    if (previewEl) previewEl.innerHTML = renderPreview(step);
    if (prevButton) prevButton.disabled = currentTourStep === 0;
    if (nextButton) nextButton.textContent = currentTourStep === tourSteps.length - 1 ? "Finish" : "Next";
    if (dotsEl) {
      dotsEl.innerHTML = tourSteps.map((tourStep, index) => `
        <button
          type="button"
          data-tour-step="${index}"
          class="h-2.5 w-2.5 rounded-full transition-colors ${index === currentTourStep ? "bg-sky-400" : "bg-gray-600 hover:bg-gray-400"}"
          aria-label="Show ${tourStep.title}"
          aria-current="${index === currentTourStep ? "step" : "false"}"
        ></button>
      `).join("");
      dotsEl.querySelectorAll("[data-tour-step]").forEach((button) => {
        button.addEventListener("click", () => {
          currentTourStep = Number((button as HTMLElement).dataset.tourStep);
          renderTourStep();
        });
      });
    }
  }

  function openTour() {
    if (!modal) return;
    lastFocusedElement = document.activeElement;
    renderTourStep();
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
    closeButton?.focus();
  }

  function closeTour() {
    if (!modal) return;
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
    if (lastFocusedElement instanceof HTMLElement) {
      lastFocusedElement.focus();
    }
  }

  document.querySelectorAll("[data-tour-open]").forEach((button) => {
    button.addEventListener("click", () => {
      currentTourStep = 0;
      openTour();
    });
  });

  closeButton?.addEventListener("click", closeTour);
  modal?.addEventListener("click", (event) => {
    if (event.target === modal) closeTour();
  });
  prevButton?.addEventListener("click", () => {
    currentTourStep = Math.max(0, currentTourStep - 1);
    renderTourStep();
  });
  nextButton?.addEventListener("click", () => {
    if (currentTourStep === tourSteps.length - 1) {
      closeTour();
      return;
    }
    currentTourStep += 1;
    renderTourStep();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && modal && !modal.classList.contains("hidden")) {
      closeTour();
    }
  });
</script>
