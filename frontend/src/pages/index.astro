---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home">
  <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
    <div class="max-w-3xl">
      <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Training Tools
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-7 text-gray-400">
        Personal cycling analytics for turning your Strava history into practical training targets.
      </p>
    </div>

    <section
      aria-labelledby="kom-qom-info-title"
      class="mt-10 rounded-lg border border-gray-800 bg-gray-900 p-5 sm:p-6"
    >
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_16rem] lg:items-start">
        <div>
          <div class="mb-3 flex items-center gap-3">
            <span
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-amber-500/40 bg-amber-500/10 text-amber-200"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8 21h8" />
                <path d="M12 17v4" />
                <path d="M7 4h10v4a5 5 0 0 1-10 0V4Z" />
                <path d="M17 5h3v1a4 4 0 0 1-4 4" />
                <path d="M7 5H4v1a4 4 0 0 0 4 4" />
              </svg>
            </span>
            <h2 id="kom-qom-info-title" class="text-xl font-semibold text-white">KOM / QOM Candidates</h2>
          </div>
          <p class="max-w-3xl text-sm leading-6 text-gray-400">
            Find realistic KOM/QOM attempts among the starred segments you already care about. Starred segments are
            the recommended base for the shortlist: see what is already yours, which podium or top-10 efforts are
            close, and how each target fits your next ride by distance, gradient, surface, effort time, and power demand.
          </p>
          <div class="mt-5 flex flex-wrap gap-2 text-xs font-medium">
            <span class="rounded border border-emerald-500/50 bg-emerald-500/10 px-2 py-1 text-emerald-300">Easy to get</span>
            <span class="rounded border border-amber-500/60 bg-amber-500/10 px-2 py-1 text-amber-200">Realistic</span>
            <span class="rounded border border-rose-500/50 bg-rose-500/10 px-2 py-1 text-rose-300">Hard</span>
            <span class="rounded border border-gray-700 bg-gray-950 px-2 py-1 text-gray-300">Rides and runs</span>
          </div>
        </div>
        <div class="space-y-3 text-sm text-gray-400">
          <div class="flex items-center justify-between gap-4 border-b border-gray-800 pb-3">
            <span>Best signal</span>
            <span class="font-medium text-gray-200">Top 10 / podium history</span>
          </div>
          <div class="flex items-center justify-between gap-4 border-b border-gray-800 pb-3">
            <span>Sort by</span>
            <span class="font-medium text-gray-200">Gap or distance</span>
          </div>
          <div class="flex items-center justify-between gap-4">
            <span>Made for</span>
            <span class="font-medium text-gray-200">Private planning</span>
          </div>
          <div class="space-y-2 pt-2">
            <button
              type="button"
              data-tour-open
              class="inline-flex h-10 w-full items-center justify-center rounded-lg bg-sky-500 px-3 text-sm font-semibold text-white transition-colors hover:bg-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-300 focus:ring-offset-2 focus:ring-offset-gray-900"
            >
              Preview tour
            </button>
            <a
              id="open-candidates-link"
              href="/kom-qom"
              class="hidden h-9 w-full items-center justify-center rounded-lg border border-gray-700 bg-gray-950 px-3 text-sm font-semibold text-gray-200 transition-colors hover:border-gray-600 hover:text-white focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 focus:ring-offset-gray-900"
            >
              Open candidates
            </a>
          </div>
        </div>
      </div>
    </section>

    <div id="auth-prompt" class="hidden mt-4 rounded-lg border border-gray-800 bg-gray-900 p-5">
      <div class="sm:flex sm:items-center sm:justify-between sm:gap-6">
        <div>
          <p class="text-sm font-semibold text-white">Connect Strava to start.</p>
          <p class="mt-2 text-sm leading-6 text-gray-400">
            See a private shortlist of KOM/QOM opportunities shaped around your own rides and runs.
          </p>
        </div>
        <a
          href="/auth/login"
          class="mt-4 inline-flex h-9 w-full items-center justify-center rounded-lg border border-gray-700 bg-gray-950 px-4 text-sm font-medium text-gray-200 transition-colors hover:border-gray-600 hover:text-white focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 focus:ring-offset-gray-900 sm:mt-0 sm:w-auto sm:shrink-0"
        >
          Connect Strava
        </a>
      </div>
    </div>
  </div>

  <div
    id="preview-tour-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-gray-950/75 px-4 py-6 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="preview-tour-title"
  >
    <div class="flex max-h-[calc(100dvh-3rem)] w-full max-w-4xl flex-col overflow-hidden rounded-lg border border-gray-600 bg-gray-900 shadow-2xl">
      <div class="flex items-start justify-between gap-4 border-b border-gray-700 px-5 py-4">
        <div>
          <p id="tour-step-label" class="text-xs font-semibold uppercase tracking-wider text-sky-300">Preview tour</p>
          <h2 id="preview-tour-title" class="mt-1 text-xl font-semibold text-white">KOM / QOM Candidates preview</h2>
        </div>
        <button
          id="preview-tour-close"
          type="button"
          class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-gray-600 bg-gray-800 text-gray-200 transition-colors hover:border-gray-500 hover:text-white focus:outline-none focus:ring-2 focus:ring-gray-400"
          aria-label="Close preview tour"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M6 6l12 12" />
            <path d="M18 6L6 18" />
          </svg>
        </button>
      </div>

      <div class="grid min-h-0 flex-1 overflow-y-auto lg:grid-cols-[0.9fr_1.1fr]">
        <div class="border-b border-gray-700 bg-gray-900 px-5 py-5 lg:border-b-0 lg:border-r">
          <p id="tour-body" class="text-sm leading-6 text-gray-300"></p>
          <div id="tour-highlights" class="mt-5 space-y-3"></div>
        </div>
        <div id="tour-preview" class="bg-gray-800 px-5 py-5"></div>
      </div>

      <div class="flex flex-col gap-3 border-t border-gray-700 bg-gray-900 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
        <div id="tour-dots" class="flex gap-2" aria-label="Preview examples"></div>
        <div class="flex gap-2">
          <button
            id="tour-prev"
            type="button"
            class="inline-flex h-9 items-center rounded-lg border border-gray-600 bg-gray-800 px-3 text-sm font-medium text-gray-200 transition-colors hover:border-gray-500 hover:text-white disabled:cursor-not-allowed disabled:opacity-50 focus:outline-none focus:ring-2 focus:ring-gray-400"
          >
            Back
          </button>
          <button
            id="tour-next"
            type="button"
            class="inline-flex h-9 items-center rounded-lg bg-sky-500 px-4 text-sm font-semibold text-white transition-colors hover:bg-sky-400 focus:outline-none focus:ring-2 focus:ring-sky-300"
          >
            Next
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  if (localStorage.getItem("tt_token")) {
    document.getElementById("open-candidates-link")?.classList.remove("hidden");
    document.getElementById("open-candidates-link")?.classList.add("inline-flex");
  } else {
    document.getElementById("auth-prompt")?.classList.remove("hidden");
  }

  const previewXomLabel = "KOM";

  function rankBadge(c: any): string {
    if (c.is_kom) return `<span class="text-yellow-400 font-bold text-xs">&#9733; ${xomLabel(c)}</span>`;
    if (c.podium_seen) return `<span class="text-sky-400 font-bold text-xs">&#129353; Podium</span>`;
    if (c.top10_seen) return `<span class="text-gray-500 text-xs">Top 10</span>`;
    return "";
  }

  function qualityBadge(c: any): string {
    if (c.data_quality === "seeded") {
      return `<span class="text-gray-500 text-xs">PR seeded</span>`;
    }
    if (c.data_quality === "enriched") {
      return `<span class="text-gray-500 text-xs">Gap enriched</span>`;
    }
    return "";
  }

  function difficultyBadge(c: any): string {
    if (c.kom_difficulty === "easy") {
      return `<span class="rounded border border-emerald-500/60 bg-emerald-500/10 px-1.5 py-0.5 text-xs font-semibold text-emerald-300">Easy to get</span>`;
    }
    if (c.kom_difficulty === "realistic") {
      return `<span class="rounded border border-amber-500/70 bg-amber-500/10 px-1.5 py-0.5 text-xs font-semibold text-amber-200">Realistic</span>`;
    }
    if (c.kom_difficulty === "hard") {
      return `<span class="rounded border border-rose-500/60 bg-rose-500/10 px-1.5 py-0.5 text-xs font-semibold text-rose-300">${c.kom_difficulty_label ?? `Hard to ${xomLabel(c)}`}</span>`;
    }
    return "";
  }

  function cardTheme(c: any): string {
    if (c.kom_difficulty === "easy") {
      return "bg-emerald-950/30 border-emerald-500/70 hover:border-emerald-400";
    }
    if (c.kom_difficulty === "realistic") {
      return "bg-amber-950/25 border-amber-500/65 hover:border-amber-400";
    }
    if (c.kom_difficulty === "hard") {
      return "bg-rose-950/20 border-rose-800/70 hover:border-rose-600";
    }
    return "bg-gray-900 border-gray-800 hover:border-gray-700";
  }

  function zoneLabel(zone: number | null | undefined): string {
    return zone != null ? ` <span class="text-gray-500">(Zone ${zone})</span>` : "";
  }

  function xomLabel(c?: any): string {
    return c?.xom_label ?? previewXomLabel;
  }

  function card(c: any): string {
    const dist = c.distance_from_home_km != null ? `${c.distance_from_home_km} km` : "&mdash;";
    const grade = c.average_grade != null ? `${c.average_grade.toFixed(1)}%` : "&mdash;";
    const distSeg = c.distance_m != null ? `${(c.distance_m / 1000).toFixed(1)} km` : "&mdash;";
    const primaryTimeLabel = c.best_time_display != null ? "Best" : c.pr_time_display != null ? "PR" : "Best";
    const primaryTime = c.best_time_display ?? c.pr_time_display ?? "&mdash;";
    const latestTime = c.latest_time_display != null
      ? `<span>Last <strong class="text-gray-200">${c.latest_time_display}</strong></span>`
      : "";
    const ridden = c.times_ridden > 0
      ? `${c.times_ridden}&times; ridden`
      : c.data_quality === "backfilled"
        ? "history unavailable"
        : "history pending";
    const gap =
      c.gap_to_kom_s != null
        ? `Gap to ${xomLabel(c)}: ${c.gap_to_kom_display} (${c.gap_to_kom_pct}%)`
        : "";
    const bestWatts = c.best_avg_watts != null
      ? `<span>Best power <strong class="text-gray-200">${Math.round(c.best_avg_watts)}W</strong>${zoneLabel(c.best_power_zone)}</span>`
      : "";
    const estimatedWatts = c.estimated_kom_power_watts != null
      ? `<span>${xomLabel(c)} target <strong class="text-gray-200">~${Math.round(c.estimated_kom_power_watts)}W avg</strong>${zoneLabel(c.estimated_kom_power_zone)}</span>`
      : "";
    const watts = [bestWatts, estimatedWatts]
      .filter(Boolean)
      .map((item) => `<span class="inline-flex items-center gap-1.5">${item}</span>`)
      .join(" ");
    const location = [c.city, c.country].filter(Boolean).join(", ");

    return `
      <div class="${cardTheme(c)} border rounded-xl p-4 transition-colors">
        <div class="flex items-start justify-between gap-3 mb-2">
          <div class="flex items-center gap-2 min-w-0">
            ${rankBadge(c)}
            ${difficultyBadge(c)}
            ${qualityBadge(c)}
            <span class="text-white font-medium truncate">
              ${c.segment_name}
            </span>
          </div>
          <div class="shrink-0 text-right">
            <span class="block text-gray-500 text-sm">${dist} from home</span>
            <a
              href="${c.segment_url}"
              target="_blank"
              rel="noopener"
              class="text-[11px] font-semibold text-gray-400 underline decoration-gray-600 underline-offset-4 hover:text-gray-200 hover:decoration-gray-300"
            >
              View on Strava
            </a>
          </div>
        </div>
        <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-400">
          <span>${primaryTimeLabel} <strong class="text-gray-200">${primaryTime}</strong></span>
          ${latestTime}
          <span>${ridden}</span>
          ${watts ? `<span class="inline-flex flex-wrap gap-x-2 gap-y-1">${watts}</span>` : ""}
        </div>
        <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-gray-500 mt-1">
          <span>${grade} avg &middot; ${distSeg}</span>
          ${gap ? `<span class="text-sky-400">${gap}</span>` : ""}
          ${location ? `<span>${location}</span>` : ""}
        </div>
      </div>`;
  }

