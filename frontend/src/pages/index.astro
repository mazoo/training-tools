---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home">
  <div class="max-w-2xl mx-auto px-6 py-16 text-center">
    <h1 class="text-3xl font-bold text-white mb-4">Training Tools</h1>
    <p class="text-gray-400 mb-10">Personal cycling analytics. Powered by Strava.</p>

    <div class="grid gap-4">
      <a
        href="/kom-qom"
        class="block bg-gray-900 border border-gray-800 rounded-xl p-6 text-left hover:border-gray-600 transition-colors"
      >
        <div class="flex items-center gap-3 mb-2">
          <span class="text-2xl">🏆</span>
          <h2 class="text-lg font-semibold text-white">KOM / QOM Candidates</h2>
        </div>
        <p class="text-gray-400 text-sm">
          Starred segments where you've historically been in the top 10 or on the podium.
          Sorted by distance from home.
        </p>
      </a>
    </div>

    <div id="auth-prompt" class="hidden mt-12 text-gray-500 text-sm">
      <p class="mb-3">Connect your Strava account to get started.</p>
      <a
        href="/auth/login"
        class="inline-block bg-sky-500 text-white px-5 py-2 rounded-lg font-medium hover:bg-sky-400 transition-colors"
      >
        Connect Strava
      </a>
    </div>
  </div>
</Layout>

<script>
  if (!localStorage.getItem("tt_token")) {
    document.getElementById("auth-prompt")?.classList.remove("hidden");
  }
</script>
