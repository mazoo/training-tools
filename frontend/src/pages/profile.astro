---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Profile">
  <div class="max-w-xl mx-auto px-6 py-12">

    <!-- Athlete header -->
    <div class="flex items-center gap-5 mb-10">
      <img
        id="profile-avatar"
        src=""
        alt=""
        class="w-16 h-16 rounded-full bg-gray-800 hidden object-cover"
      />
      <div id="profile-avatar-placeholder" class="w-16 h-16 rounded-full bg-gray-800 flex items-center justify-center text-gray-500 text-2xl">
        ?
      </div>
      <h1 id="profile-name" class="text-2xl font-bold text-white">—</h1>
    </div>

    <!-- Strava connection card -->
    <section class="bg-gray-900 border border-gray-800 rounded-xl p-6 mb-6">
      <h2 class="text-base font-semibold text-white mb-4">Strava Connection</h2>

      <div id="connected-section" class="hidden">
        <div class="flex items-center gap-3 mb-5">
          <span class="w-2 h-2 rounded-full bg-green-500 shrink-0"></span>
          <span class="text-sm text-gray-300">Connected</span>
        </div>
        <button
          id="btn-disconnect"
          class="text-sm text-red-400 hover:text-red-300 border border-red-900 hover:border-red-700 px-4 py-2 rounded-lg transition-colors"
        >
          Disconnect Strava
        </button>
        <p id="disconnect-error" class="hidden mt-3 text-sm text-red-400"></p>
      </div>

      <div id="disconnected-section" class="hidden">
        <div class="flex items-center gap-3 mb-5">
          <span class="w-2 h-2 rounded-full bg-gray-600 shrink-0"></span>
          <span class="text-sm text-gray-400">Not connected</span>
        </div>
        <a
          href="/auth/login"
          class="inline-block bg-sky-500 text-white text-sm px-5 py-2 rounded-lg font-medium hover:bg-sky-400 transition-colors"
        >
          Connect Strava
        </a>
      </div>
    </section>

    <!-- Strava API token debug card -->
    <section id="strava-token-section" class="hidden bg-gray-900 border border-gray-800 rounded-xl p-6 mb-6">
      <h2 class="text-base font-semibold text-white mb-4">Strava API Token</h2>
      <div class="space-y-3">
        <div>
          <span class="text-xs text-gray-400 uppercase tracking-wide mb-1.5 block">Access Token</span>
          <pre id="strava-access-token" class="min-h-10 whitespace-pre-wrap break-all rounded-lg border border-gray-800 bg-gray-950 px-3 py-2 text-xs text-gray-200">Loading…</pre>
        </div>
        <p id="strava-token-error" class="hidden text-sm text-red-400"></p>
      </div>
    </section>

    <!-- KOM/QOM Candidates card -->
    <section class="bg-gray-900 border border-gray-800 rounded-xl p-6 mb-6">
      <h2 class="text-base font-semibold text-white mb-6">KOM/QOM Candidates</h2>

      <!-- Home Location subsection -->
      <div class="mb-6">
        <h3 class="text-sm font-medium text-gray-300 mb-1">Home Location</h3>
        <p class="text-sm text-gray-500 mb-4">
          Used to sort candidates by distance from home.
        </p>

        <form id="home-form" class="space-y-4">
          <label class="block">
            <span class="text-xs text-gray-400 uppercase tracking-wide mb-1.5 block">Address</span>
            <input
              id="home-address"
              type="text"
              autocomplete="street-address"
              placeholder="Fegetzhofweg 36, Solothurn"
              class="w-full bg-gray-800 border border-gray-700 rounded-lg px-3 py-2 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-gray-500"
            />
          </label>

          <p id="home-coords" class="text-xs text-gray-600 hidden"></p>

          <div class="flex items-center gap-3 flex-wrap">
            <button
              type="submit"
              id="btn-save-home"
              class="text-sm bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg transition-colors disabled:opacity-50"
            >
              Save
            </button>
            <span id="home-feedback" class="text-sm"></span>
          </div>
        </form>
      </div>

      <div class="border-t border-gray-800 my-6"></div>

      <!-- Data Housekeeping subsection -->
      <div>
        <h3 class="text-sm font-medium text-gray-300 mb-1">Data Housekeeping</h3>
        <p id="housekeeping-description" class="text-sm text-gray-500 mb-4">
          Sync recent Strava activities.
        </p>

        <div class="flex flex-wrap gap-2">
          <button
            id="btn-refresh"
            class="text-sm bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg transition-colors disabled:opacity-50"
          >
            Refresh data
          </button>
          <button
            id="btn-backfill"
            class="hidden text-sm bg-sky-600 hover:bg-sky-500 disabled:bg-sky-900 disabled:text-sky-200/60 border border-sky-500/60 disabled:border-sky-800 text-white px-4 py-2 rounded-lg transition-colors"
          >
            Run daily backfill
          </button>
        </div>
        <p id="housekeeping-status" class="hidden text-sm text-gray-400 mt-3"></p>
      </div>
    </section>

    <!-- Danger zone -->
    <section id="danger-zone" class="hidden border border-red-900 rounded-xl p-6">
      <h2 class="text-base font-semibold text-red-400 mb-1">Danger Zone</h2>
      <p class="text-sm text-gray-500 mb-5">
        Permanently deletes your account and locally stored training data from Training Tools. Your Strava data is not deleted.
      </p>

      <div id="delete-confirm" class="hidden mb-4 bg-gray-900 border border-red-800 rounded-lg p-4">
        <p class="text-sm text-white mb-4">Are you sure? All your segment history and KOM data will be permanently deleted.</p>
        <div class="flex gap-3">
          <button
            id="btn-delete-confirm"
            class="text-sm bg-red-700 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition-colors"
          >
            Yes, delete my account
          </button>
          <button
            id="btn-delete-cancel"
            class="text-sm text-gray-400 hover:text-white px-4 py-2 rounded-lg transition-colors"
          >
            Cancel
          </button>
        </div>
      </div>

      <button
        id="btn-delete-account"
        class="text-sm text-red-400 hover:text-red-300 border border-red-900 hover:border-red-700 px-4 py-2 rounded-lg transition-colors"
      >
        Delete My Account
      </button>
      <p id="delete-error" class="hidden mt-3 text-sm text-red-400"></p>
    </section>

  </div>
</Layout>

<script>
  const token = localStorage.getItem("tt_token");

  async function apiFetch(path: string, opts: RequestInit = {}) {
    return fetch(path, {
      ...opts,
      headers: {
        Authorization: `Bearer ${token}`,
        "Content-Type": "application/json",
        ...(opts.headers ?? {}),
      },
    });
  }

  const BACKFILL_FROM_UI = "backfill_from_ui";
  const STRAVA_API_TOKEN_VISIBLE = "strava_api_token_visible";
  const debugParams = new URLSearchParams(window.location.search);
  const showStravaTokenDebug = debugParams.has("debug");
  let canRunBackfill = false;

  async function init() {
    if (!token) {
      showDisconnected();
      return;
    }
    const res = await apiFetch("/api/auth/me");
    if (!res.ok) {
      showDisconnected();
      return;
    }
    const data = await res.json();
    showConnected(data);
  }

  function showConnected(data: {
    firstname?: string | null;
    lastname?: string | null;
    profile?: string | null;
    home_address?: string | null;
    home_lat?: number | null;
    home_lng?: number | null;
    permissions?: string[];
  }) {
    const name = [data.firstname, data.lastname].filter(Boolean).join(" ") || "Athlete";
    (document.getElementById("profile-name") as HTMLElement).textContent = name;

    if (data.profile) {
      const img = document.getElementById("profile-avatar") as HTMLImageElement;
      img.src = data.profile;
      img.alt = name;
      img.classList.remove("hidden");
      document.getElementById("profile-avatar-placeholder")?.classList.add("hidden");
    }

    document.getElementById("connected-section")?.classList.remove("hidden");
    document.getElementById("disconnected-section")?.classList.add("hidden");
    document.getElementById("danger-zone")?.classList.remove("hidden");

    if (data.home_address) {
      (document.getElementById("home-address") as HTMLInputElement).value = data.home_address;
    }
    if (data.home_lat != null && data.home_lng != null) {
      const coordsEl = document.getElementById("home-coords") as HTMLElement;
      coordsEl.textContent = `${data.home_lat.toFixed(5)}, ${data.home_lng.toFixed(5)}`;
      coordsEl.classList.remove("hidden");
    }

    canRunBackfill = data.permissions?.includes(BACKFILL_FROM_UI) ?? false;
    updateHousekeepingDescription();

    if (showStravaTokenDebug && data.permissions?.includes(STRAVA_API_TOKEN_VISIBLE)) {
      loadStravaAccessToken();
    }

    if (canRunBackfill) {
      loadBackfillAvailability();
    }
  }

  async function loadStravaAccessToken() {
    document.getElementById("strava-token-section")?.classList.remove("hidden");
    const tokenEl = document.getElementById("strava-access-token") as HTMLElement;
    const errorEl = document.getElementById("strava-token-error") as HTMLElement;

    const res = await apiFetch("/api/profile/strava-token");
    if (res.ok) {
      const data = await res.json();
      tokenEl.textContent = data.access_token ?? "No token returned.";
      errorEl.classList.add("hidden");
      return;
    }

    tokenEl.textContent = "Unavailable";
    errorEl.textContent = "Failed to load Strava API token.";
    errorEl.classList.remove("hidden");
  }

  function showDisconnected() {
    (document.getElementById("profile-name") as HTMLElement).textContent = "Not connected";
    document.getElementById("disconnected-section")?.classList.remove("hidden");
    document.getElementById("connected-section")?.classList.add("hidden");
    const form = document.getElementById("home-form") as HTMLFormElement;
    form.style.opacity = "0.4";
    form.style.pointerEvents = "none";
    (document.getElementById("btn-refresh") as HTMLButtonElement).disabled = true;
  }

  // ── Data Housekeeping ──────────────────────────────────────────────────────

  function updateHousekeepingDescription() {
    const description = document.getElementById("housekeeping-description") as HTMLElement;
    description.textContent = canRunBackfill
      ? "Sync recent Strava activities or run the full historical backfill."
      : "Sync recent Strava activities.";
  }

  async function loadBackfillAvailability() {
    const btn = document.getElementById("btn-backfill") as HTMLButtonElement;
    btn.classList.add("hidden");
    if (!canRunBackfill) return;
    try {
      const res = await apiFetch("/api/kom-qom/backfill/availability");
      if (!res.ok) return;
      const data = await res.json();
      if (data.available) {
        btn.disabled = false;
        btn.textContent = "Run daily backfill";
        btn.classList.remove("hidden");
      }
    } catch {
      // backfill button stays hidden
    }
  }

  function setHousekeepingStatus(text: string, tone: "neutral" | "ok" | "error" = "neutral") {
    const el = document.getElementById("housekeeping-status") as HTMLElement;
    el.textContent = text;
    el.className = [
      "text-sm mt-3",
      tone === "ok" ? "text-green-400" : tone === "error" ? "text-red-400" : "text-gray-400",
    ].join(" ");
    el.classList.remove("hidden");
  }

  async function pollTask(
    taskId: string,
    path: string,
    label: (s: any) => string,
    onDone: () => void
  ) {
    const poll = setInterval(async () => {
      try {
        const sr = await apiFetch(`${path}/${taskId}`);
        const s = await sr.json();
        setHousekeepingStatus(label(s));
        if (s.status === "done" || s.status === "error" || s.status === "rate_limited") {
          clearInterval(poll);
          if (s.status === "done") {
            setHousekeepingStatus("Done.", "ok");
            setTimeout(() => {
              document.getElementById("housekeeping-status")?.classList.add("hidden");
            }, 3000);
          } else if (s.status === "rate_limited") {
            const retryMin = s.retry_after
              ? Math.ceil((new Date(s.retry_after).getTime() - Date.now()) / 60000)
              : 15;
            setHousekeepingStatus(`Rate limited — retry in ~${retryMin} min.`, "error");
          } else {
            setHousekeepingStatus(s.error ?? "Something went wrong.", "error");
          }
          onDone();
        }
      } catch {
        clearInterval(poll);
        setHousekeepingStatus("Lost connection to server.", "error");
        onDone();
      }
    }, 3000);
  }

  document.getElementById("btn-refresh")?.addEventListener("click", async () => {
    const btn = document.getElementById("btn-refresh") as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = "Syncing…";
    setHousekeepingStatus("Starting sync…");

    try {
      const res = await apiFetch("/api/kom-qom/refresh", { method: "POST" });
      if (!res.ok) throw new Error();
      const { task_id } = await res.json();
      pollTask(
        task_id,
        "/api/kom-qom/refresh",
        (s) => `Synced ${s.activities_processed} / ${s.activities_total ?? "?"} activities`,
        () => {
          btn.disabled = false;
          btn.textContent = "Refresh data";
          loadBackfillAvailability();
        }
      );
    } catch {
      setHousekeepingStatus("Failed to start sync.", "error");
      btn.disabled = false;
      btn.textContent = "Refresh data";
    }
  });

  document.getElementById("btn-backfill")?.addEventListener("click", async () => {
    const btn = document.getElementById("btn-backfill") as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = "Backfilling…";
    setHousekeepingStatus("Starting backfill…");

    try {
      const res = await apiFetch("/api/kom-qom/backfill", { method: "POST" });
      if (!res.ok) throw new Error();
      const { task_id } = await res.json();
      pollTask(
        task_id,
        "/api/kom-qom/backfill",
        (s) => `Backfilled ${s.activities_processed} / ${s.activities_total ?? "?"} segments`,
        () => {
          btn.disabled = false;
          btn.textContent = "Run daily backfill";
          loadBackfillAvailability();
        }
      );
    } catch {
      setHousekeepingStatus("Failed to start backfill.", "error");
      btn.disabled = false;
      btn.textContent = "Run daily backfill";
    }
  });

  // Disconnect
  document.getElementById("btn-disconnect")?.addEventListener("click", async () => {
    const btn = document.getElementById("btn-disconnect") as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = "Disconnecting…";

    const res = await apiFetch("/api/profile/disconnect", { method: "POST" });
    if (res.ok) {
      localStorage.removeItem("tt_token");
      window.location.href = "/";
    } else {
      const errEl = document.getElementById("disconnect-error") as HTMLElement;
      errEl.textContent = "Failed to disconnect. Try again.";
      errEl.classList.remove("hidden");
      btn.disabled = false;
      btn.textContent = "Disconnect Strava";
    }
  });

  // Delete account
  document.getElementById("btn-delete-account")?.addEventListener("click", () => {
    document.getElementById("delete-confirm")?.classList.remove("hidden");
    (document.getElementById("btn-delete-account") as HTMLButtonElement).classList.add("hidden");
  });

  document.getElementById("btn-delete-cancel")?.addEventListener("click", () => {
    document.getElementById("delete-confirm")?.classList.add("hidden");
    (document.getElementById("btn-delete-account") as HTMLButtonElement).classList.remove("hidden");
  });

  document.getElementById("btn-delete-confirm")?.addEventListener("click", async () => {
    const btn = document.getElementById("btn-delete-confirm") as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = "Deleting…";

    const res = await apiFetch("/api/profile/account", { method: "DELETE" });
    if (res.ok) {
      localStorage.removeItem("tt_token");
      window.location.href = "/";
    } else {
      const errEl = document.getElementById("delete-error") as HTMLElement;
      errEl.textContent = "Failed to delete account. Try again.";
      errEl.classList.remove("hidden");
      btn.disabled = false;
      btn.textContent = "Yes, delete my account";
    }
  });

  // Save home address
  document.getElementById("home-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const address = (document.getElementById("home-address") as HTMLInputElement).value.trim();
    const feedback = document.getElementById("home-feedback") as HTMLElement;
    const btn = document.getElementById("btn-save-home") as HTMLButtonElement;

    if (!address) {
      feedback.textContent = "Please enter an address.";
      feedback.className = "text-sm text-red-400";
      return;
    }

    btn.disabled = true;
    feedback.textContent = "Geocoding…";
    feedback.className = "text-sm text-gray-400";

    const res = await apiFetch("/api/profile/home", {
      method: "PUT",
      body: JSON.stringify({ address }),
    });

    btn.disabled = false;

    if (res.ok) {
      const data = await res.json();
      const coordsEl = document.getElementById("home-coords") as HTMLElement;
      coordsEl.textContent = `${(data.home_lat as number).toFixed(5)}, ${(data.home_lng as number).toFixed(5)}`;
      coordsEl.classList.remove("hidden");
      feedback.textContent = "Saved.";
      feedback.className = "text-sm text-green-400";
      setTimeout(() => { feedback.textContent = ""; }, 2000);
    } else {
      const body = await res.json().catch(() => ({}));
      feedback.textContent = (body as { detail?: string }).detail ?? "Failed to save. Try again.";
      feedback.className = "text-sm text-red-400";
    }
  });

  init();
</script>
